# Optional. Copy to `.env` (repo root) to override docker compose defaults.
# Every value has a working default, so `docker compose up -d --build` works without this file.
# App secrets (JWT_SECRET_KEY, OPENROUTER_API_KEY, ...) live in backend/.env, not here.

# APP_ENV=development            # "production" enforces strong INGEST_TOKEN and disables HTTP ingest
# POSTGRES_PASSWORD=volta
# TIMESCALE_PASSWORD=volta
# RABBITMQ_PASSWORD=volta
# INGEST_TOKEN=dev-ingest-token

# Host ports (all bound to 127.0.0.1)
# API_PORT=8000
# DASHBOARD_PORT=8765
# POSTGRES_PORT=5434
# TIMESCALE_PORT=5433
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_UI_PORT=15672

# live = Open-Meteo weather; fallback = offline synthetic weather
# SIMULATOR_WEATHER_MODE=live

