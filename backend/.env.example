# Copy to `.env` and fill in real values. Never commit `.env`.
# All keys are also documented on `app.core.config.Settings`.

# --- App ---
APP_NAME=Volta Auth Service
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Async SQLAlchemy needs the postgresql+asyncpg:// prefix.
# Do NOT append ?sslmode=... — asyncpg does not parse it. Use DB_SSL_REQUIRED.
# Neon example:
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/neondb
#   DB_SSL_REQUIRED=true
DATABASE_URL=postgresql+asyncpg://volta_user:volta_password@localhost:5432/volta_auth
DB_SSL_REQUIRED=false

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-secret-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma-separated if you override via env; pydantic-settings accepts JSON lists too) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:8765","http://localhost:8765"]

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute
RATE_LIMIT_INGEST=120/minute

# --- Telemetry ingest (HTTP path = tests/dev only) ---
# Shared secret, not a user JWT. Simulator production path is RabbitMQ.
# Must be a strong secret when ENVIRONMENT=production.
INGEST_TOKEN=dev-ingest-token
INGEST_HTTP_ENABLED=true
ENERGY_HISTORY_MAX_READINGS=2880
ENERGY_BALANCE_TOLERANCE_KW=0.05
DEFAULT_ENERGY_CHARGE_INR_PER_KWH=8.50
DEFAULT_EXPORT_CREDIT_INR_PER_KWH=6.20
DEVICE_IMPORTANT_POWER_KW=1.50

# --- TimescaleDB (telemetry history). NOT the Neon auth database. ---
# Local: docker compose up -d  (port 5433 so it does not collide with Neon/local 5432)
TIMESCALE_DATABASE_URL=postgresql+asyncpg://volta:volta@localhost:5433/volta_ts
TIMESCALE_SSL_REQUIRED=false
TIMESCALE_COMPRESS_AFTER_DAYS=7
TIMESCALE_RETENTION_DAYS=90
# Timescale Cloud later:
#   TIMESCALE_DATABASE_URL=postgresql+asyncpg://tsdbadmin:PASS@HOST:5432/tsdb
#   TIMESCALE_SSL_REQUIRED=true

# --- Redis (live snapshot + pub/sub) ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=volta:live:
REDIS_LIVE_TTL_SECONDS=120
# Redis Cloud / Upstash later: rediss://default:PASS@HOST:6379

# --- RabbitMQ (simulator publishes, worker consumes) ---
RABBITMQ_URL=amqp://volta:volta@localhost:5672/volta
RABBITMQ_EXCHANGE=telemetry
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=telemetry.ingest
RABBITMQ_QUEUE=telemetry.ingest
RABBITMQ_PREFETCH=50
RABBITMQ_DLX=telemetry.dlx
RABBITMQ_DLQ=telemetry.ingest.dead
# CloudAMQP later: amqps://USER:PASS@HOST/VHOST

# --- WebSocket (dashboard live feed) ---
WS_PATH=/ws/energy
WS_HEARTBEAT_SECONDS=30
TELEMETRY_IO_ENABLED=true

# --- Frontend (OAuth redirect target) ---
FRONTEND_URL=http://localhost:3000

# --- AI assistant (Suryaa, read-only phase) ---
# Provider ids: google_genai | anthropic | openai | groq | ollama
# Without a key the assistant still answers in deterministic mode (meta.llm_used=false).
AI_ENABLED=true

# Answer model. Cheapest start: Gemini Flash-Lite (free tier in Google AI Studio).
AI_LLM_PROVIDER=google_genai
AI_LLM_MODEL=gemini-3.5-flash-lite
# Claude (target):
#   AI_LLM_PROVIDER=anthropic
#   AI_LLM_MODEL=claude-haiku-4-5

# Router model for ambiguous questions only. Empty = same as answer model.
AI_ROUTER_LLM_PROVIDER=
AI_ROUTER_LLM_MODEL=
# Used if the answer provider errors / times out. Empty = no fallback.
AI_FALLBACK_LLM_PROVIDER=
AI_FALLBACK_LLM_MODEL=

AI_LLM_TEMPERATURE=0.1
AI_LLM_MAX_OUTPUT_TOKENS=800
AI_LLM_TIMEOUT_SECONDS=20
AI_LLM_MAX_RETRIES=2
# Ollama / OpenAI-compatible gateway only
AI_LLM_BASE_URL=

# Provider keys — set only the ones you use. Never commit real values.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

AI_TOOL_TIMEOUT_SECONDS=5
AI_STALE_DATA_SECONDS=600
AI_MAX_QUESTION_CHARS=500
RATE_LIMIT_ASSISTANT=20/minute

# Optional LangSmith tracing (graph, tools, LLM calls)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=suryaa-assistant

# --- Knowledge / RAG ---
# Local hashing embedder is used when AI_EMBEDDING_PROVIDER is empty.
# Set openai or google_genai plus the matching API key to use hosted embeddings.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=hashing-256
AI_EMBEDDING_DIMENSIONS=256
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.08
KNOWLEDGE_STORAGE_DIR=var/knowledge
KNOWLEDGE_MAX_UPLOAD_BYTES=15728640
KNOWLEDGE_USE_PGVECTOR=true
RATE_LIMIT_KNOWLEDGE=30/minute
# Comma-separated. Users with is_admin=true are admins even if this is empty.
SURYAA_ADMIN_EMAILS=

# --- Device commands (off until you explicitly enable them) ---
DEVICE_CONTROL_ENABLED=false
DEVICE_KILL_SWITCH=true
DEVICE_COMMAND_EXCHANGE=device.commands
DEVICE_COMMAND_QUEUE=device.commands
DEVICE_COMMAND_ROUTING_KEY=device.command
