# Copy to `.env` and fill in real values. Never commit `.env`.
# All keys are also documented on `app.core.config.Settings`.

# --- App ---
APP_NAME=Volta Auth Service
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Async SQLAlchemy needs the postgresql+asyncpg:// prefix.
# Do NOT append ?sslmode=... — asyncpg does not parse it. Use DB_SSL_REQUIRED.
# Neon example:
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/neondb
#   DB_SSL_REQUIRED=true
DATABASE_URL=postgresql+asyncpg://volta_user:volta_password@localhost:5432/volta_auth
DB_SSL_REQUIRED=false

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-secret-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma-separated if you override via env; pydantic-settings accepts JSON lists too) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Rate limiting ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute
RATE_LIMIT_INGEST=120/minute

# --- Telemetry ingest (simulator → POST /energy/ingest) ---
# Shared secret, not a user JWT. Simulator sends it as header X-Ingest-Token.
# Must be changed to a strong secret when ENVIRONMENT=production.
INGEST_TOKEN=dev-ingest-token
ENERGY_HISTORY_MAX_READINGS=2880
ENERGY_BALANCE_TOLERANCE_KW=0.05

# --- Frontend (OAuth redirect target) ---
FRONTEND_URL=http://localhost:3000
