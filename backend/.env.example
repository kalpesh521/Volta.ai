# Copy to `.env` and fill in real values. Never commit `.env`.
# All keys are also documented on `app.core.config.Settings`.

# --- App ---
APP_NAME=Volta Auth Service
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Async SQLAlchemy needs the postgresql+asyncpg:// prefix.
# Do NOT append ?sslmode=... — asyncpg does not parse it. Use DB_SSL_REQUIRED.
# Neon example:
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/neondb
#   DB_SSL_REQUIRED=true
DATABASE_URL=postgresql+asyncpg://volta_user:volta_password@localhost:5432/volta_auth
DB_SSL_REQUIRED=false

# --- JWT ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-secret-in-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Tolerated clock skew (seconds) when checking token issue/expiry times.
JWT_LEEWAY_SECONDS=10
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS (comma-separated if you override via env; pydantic-settings accepts JSON lists too) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:8765","http://localhost:8765"]

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Rate limiting ---
# Empty = counters live in this process (one replica only). A Redis URL shares them across
# replicas and restarts. Use a different database index than REDIS_URL (live data).
RATE_LIMIT_STORAGE_URI=
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PASSWORD_RESET=3/minute
RATE_LIMIT_INGEST=120/minute

# --- Telemetry ingest (HTTP path = tests/dev only) ---
# Shared secret, not a user JWT. Simulator production path is RabbitMQ.
# Must be a strong secret when ENVIRONMENT=production.
INGEST_TOKEN=dev-ingest-token
INGEST_HTTP_ENABLED=true
ENERGY_HISTORY_MAX_READINGS=2880
ENERGY_BALANCE_TOLERANCE_KW=0.05
DEFAULT_ENERGY_CHARGE_INR_PER_KWH=8.50
DEFAULT_EXPORT_CREDIT_INR_PER_KWH=6.20
DEVICE_IMPORTANT_POWER_KW=1.50

# --- TimescaleDB (telemetry history). NOT the Neon auth database. ---
# Local: docker compose up -d  (port 5433 so it does not collide with Neon/local 5432)
TIMESCALE_DATABASE_URL=postgresql+asyncpg://volta:volta@localhost:5433/volta_ts
TIMESCALE_SSL_REQUIRED=false
TIMESCALE_COMPRESS_AFTER_DAYS=7
TIMESCALE_RETENTION_DAYS=90
# Timescale Cloud later:
#   TIMESCALE_DATABASE_URL=postgresql+asyncpg://tsdbadmin:PASS@HOST:5432/tsdb
#   TIMESCALE_SSL_REQUIRED=true

# --- Redis (live snapshot + pub/sub) ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=volta:live:
REDIS_LIVE_TTL_SECONDS=120
# Redis Cloud / Upstash later: rediss://default:PASS@HOST:6379

# --- RabbitMQ (simulator publishes, worker consumes) ---
RABBITMQ_URL=amqp://volta:volta@localhost:5672/volta
RABBITMQ_EXCHANGE=telemetry
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY=telemetry.ingest
RABBITMQ_QUEUE=telemetry.ingest
RABBITMQ_PREFETCH=50
RABBITMQ_DLX=telemetry.dlx
RABBITMQ_DLQ=telemetry.ingest.dead
# CloudAMQP later: amqps://USER:PASS@HOST/VHOST

# --- WebSocket (dashboard live feed) ---
WS_PATH=/ws/energy
WS_HEARTBEAT_SECONDS=30
TELEMETRY_IO_ENABLED=true

# --- Frontend (OAuth redirect target) ---
FRONTEND_URL=http://localhost:3000

# --- Observability ---
LOG_LEVEL=INFO
# true = one JSON object per line, for log shippers
LOG_JSON=false
# Traces go to an OTLP/HTTP collector, e.g. http://otel-collector:4318
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=1.0
# Prometheus /metrics on the API. Unauthenticated: keep it on an internal network.
METRICS_ENABLED=false
# Workers have no HTTP server; a port above 0 starts a metrics endpoint for them.
WORKER_METRICS_PORT=0

# --- AI assistant (Suryaa, read-only phase) ---
# Provider ids: openrouter | google_genai | anthropic | openai | groq | ollama
# Without a key the assistant still answers in deterministic mode (meta.llm_used=false).
AI_ENABLED=true

# Answer model. OpenRouter (one key, many models) — model ids look like "vendor/model".
# Pick a model that supports tool calling / structured output.
AI_LLM_PROVIDER=openrouter
AI_LLM_MODEL=openai/gpt-4o-mini
# Google instead:
#   AI_LLM_PROVIDER=google_genai
#   AI_LLM_MODEL=gemini-3.5-flash-lite
# Claude (target):
#   AI_LLM_PROVIDER=anthropic
#   AI_LLM_MODEL=claude-haiku-4-5

# Router model for ambiguous questions only. Empty = same as answer model.
AI_ROUTER_LLM_PROVIDER=
AI_ROUTER_LLM_MODEL=
# Used if the answer provider errors / times out. Empty = no fallback.
AI_FALLBACK_LLM_PROVIDER=
AI_FALLBACK_LLM_MODEL=

AI_LLM_TEMPERATURE=0.1
AI_LLM_MAX_OUTPUT_TOKENS=800
AI_LLM_TIMEOUT_SECONDS=20
AI_LLM_MAX_RETRIES=2
# Ollama / OpenAI-compatible gateway only. Leave empty for OpenRouter
# (defaults to https://openrouter.ai/api/v1).
AI_LLM_BASE_URL=

# Provider keys — set only the ones you use. Never commit real values.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

AI_TOOL_TIMEOUT_SECONDS=5
AI_STALE_DATA_SECONDS=600
AI_MAX_QUESTION_CHARS=500
RATE_LIMIT_ASSISTANT=20/minute

# Every number in an LLM answer must trace back to the facts it was given.
#   enforce = replace an ungrounded answer with the deterministic one (default)
#   observe = log and count it but still return the LLM answer (measure first)
#   off     = no check
AI_GROUNDING_MODE=enforce

# --- v2 supervisor (/v2/assistant/...) ---
# Whole-request ceiling. The answer model alone may take up to AI_LLM_TIMEOUT_SECONDS.
AI_SUPERVISOR_DEADLINE_SECONDS=30
# Per-agent ceilings. A slow agent becomes a `timeout` result and never blocks the others.
# Keep each above AI_TOOL_TIMEOUT_SECONDS (the agent waits on tools that run in parallel).
AI_ENERGY_AGENT_DEADLINE_SECONDS=8
AI_KNOWLEDGE_AGENT_DEADLINE_SECONDS=10
AI_DEVICE_ACTION_AGENT_DEADLINE_SECONDS=8
# Answer generations per question. 2 = one regeneration when grounding fails; 1 = none.
AI_ANSWER_MAX_ATTEMPTS=2
# Earlier questions read to resolve a follow-up ("why?", "and tomorrow?").
AI_MEMORY_WINDOW_TURNS=4
# Conversations idle longer than this are deleted with their checkpoints by
# `python -m app.agents_platform.maintenance`.
AI_CONVERSATION_RETENTION_DAYS=30

# --- Guardrails (Phase 2) -------------------------------------------------------
# Input guard: normalise, score for prompt injection, refuse strong attempts. off | observe | enforce.
# `observe` counts and logs what would have been refused without acting: use it to measure a change first.
AI_GUARD_MODE=enforce
# Fast-path score (0..1) at or above which an input is refused, and the grey zone below it.
AI_GUARD_BLOCK_SCORE=0.8
AI_GUARD_GREY_SCORE=0.4
# A grey-zone input (between the two scores) is sent to a small model when true. Costs one small call
# per grey input. Without it, grey inputs stay "untrusted": no router model, no device action.
AI_GUARD_CLASSIFIER_ENABLED=false
# Empty = the router model, then the answer model.
AI_GUARD_LLM_PROVIDER=
AI_GUARD_LLM_MODEL=
# Repeated refused injections lead to a cool-down: strikes inside the window, then a wait that doubles.
AI_GUARD_STRIKE_LIMIT=3
AI_GUARD_STRIKE_WINDOW_SECONDS=600
AI_GUARD_COOLDOWN_BASE_SECONDS=60
AI_GUARD_COOLDOWN_MAX_SECONDS=3600
# Personal data typed into the chat (email, phone, ids) is masked before the model or a checkpoint sees it;
# card, bank, UPI and secrets refuse the message. off | observe | enforce.
AI_PII_MODE=enforce
# memory = this process (correct for one API process). redis = AES-GCM encrypted and shared.
# The redis vault needs a key:  python -c "from app.agents_platform.guardrails.pii.vault import generate_key; print(generate_key())"
AI_PII_VAULT_BACKEND=memory
AI_PII_VAULT_KEY=
AI_PII_VAULT_TTL_SECONDS=900
# Claims of acting on a device ("I switched it off") and unsafe electrical advice. off | observe | enforce.
AI_OUTPUT_POLICY_MODE=enforce

# --- Token budgets, kill switches, registry (Phase 2) ----------------------------
# Where budgets, cool-downs and runtime flag overrides live. memory = per process (development).
# redis = shared by every API replica (use this in production). AI_REDIS_URL empty = REDIS_URL.
AI_PLATFORM_STORE=memory
AI_REDIS_URL=
# Tokens per user per UTC day by plan tier (users.plan_tier: free | plus). A typical question uses 150 to 2,000.
AI_BUDGET_ENABLED=true
AI_BUDGET_DAILY_TOKENS_FREE=30000
AI_BUDGET_DAILY_TOKENS_PLUS=200000
# degrade = keep answering from verified facts without the model; reject = 429 until the next UTC day.
AI_BUDGET_EXHAUSTED_ACTION=degrade
# Flags switched off at startup, comma-separated: ai.llm.enabled, ai.agent.<energy_insight|knowledge|device_action>.enabled.
# An admin can override at runtime with PUT /v2/assistant/admin/flags/{flag}. An unknown name stops startup.
AI_FLAGS_DISABLED=
# Prompt versions. Empty = the registry default (the measured one). A rollback is clearing these.
AI_PROMPT_ANSWER_VERSION=
AI_PROMPT_ROUTER_VERSION=

# LangGraph checkpoints. "memory" is lost on restart: development only.
# Production must use "postgres" (the API refuses to start otherwise).
AI_CHECKPOINT_BACKEND=memory
# Empty reuses DATABASE_URL. Tables go in their own schema.
AI_CHECKPOINT_DATABASE_URL=
AI_CHECKPOINT_SCHEMA=langgraph
AI_CHECKPOINT_POOL_MIN=1
AI_CHECKPOINT_POOL_MAX=10

# Optional LangSmith tracing (graph, tools, LLM calls)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=suryaa-assistant

# --- Knowledge / RAG ---
# The local hashing embedder is an offline fallback with no understanding of meaning.
# For real use set a provider plus its key: openai | google_genai | openrouter.
#   AI_EMBEDDING_PROVIDER=openrouter
#   AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# The vector column is 256-wide, so keep AI_EMBEDDING_DIMENSIONS=256 (text-embedding-3 and
# Gemini embeddings can return that size natively). After changing provider or model, run
#   python -m app.modules.knowledge.reembed
# once, or existing documents will not be found.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=hashing-256
AI_EMBEDDING_DIMENSIONS=256
# Candidates taken from each indexed search (vector, full-text) before ranking.
RAG_VECTOR_CANDIDATES=40
RAG_LEXICAL_CANDIDATES=40
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_MIN_SCORE=0.08
KNOWLEDGE_STORAGE_DIR=var/knowledge
KNOWLEDGE_MAX_UPLOAD_BYTES=15728640
KNOWLEDGE_USE_PGVECTOR=true
RATE_LIMIT_KNOWLEDGE=30/minute
# Comma-separated. Users with is_admin=true are admins even if this is empty.
SURYAA_ADMIN_EMAILS=

# --- Device commands (off until you explicitly enable them) ---
DEVICE_CONTROL_ENABLED=false
DEVICE_KILL_SWITCH=true
DEVICE_COMMAND_EXCHANGE=device.commands
DEVICE_COMMAND_QUEUE=device.commands
DEVICE_COMMAND_SIMULATOR_QUEUE=simulator.device.commands
DEVICE_COMMAND_ROUTING_KEY=device.command
# How long a proposed action may wait for confirmation, and how long finished proposals keep
# their paused graph state before `python -m app.modules.assistant.actions.maintenance` prunes it.
ACTION_CONFIRMATION_TTL_SECONDS=120
ACTION_CHECKPOINT_RETENTION_HOURS=24

# --- Alerts (in-app WebSocket always; email only when a provider key is set) ---
# CELERY_BROKER_URL=amqp://volta:volta@localhost:5672/volta
EMAIL_PROVIDER=
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=Suryaa <alerts@localhost>
NOTIFICATION_CACHE_TTL_SECONDS=30
