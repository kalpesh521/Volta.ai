# Copy to .env and adjust. Every value is optional — defaults are used when omitted.
# Adding a new key here does not require code changes unless a generator reads it.

# --- Household / location ---
HOUSEHOLD_ID=home_001
LOCATION_NAME=Pimpri-Chinchwad
LOCATION_COUNTRY_CODE=IN
# Leave TIMEZONE / LATITUDE / LONGITUDE as fallbacks. Open-Meteo geocoding
# overwrites them at startup when GEOCODE_ON_START=true.
TIMEZONE=Asia/Kolkata
LATITUDE=18.6298
LONGITUDE=73.7997
GEOCODE_ON_START=true
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
GEOCODING_LANGUAGE=en

# --- Solar ---
SOLAR_CAPACITY_KWP=5.0
INVERTER_CAPACITY_KW=5.0
SOLAR_EFFICIENCY=0.82
SHADING_FACTOR=0.95

# --- Battery ---
BATTERY_PRESENT=true
BATTERY_CAPACITY_KWH=10.0
BATTERY_USABLE_CAPACITY_KWH=8.0
INITIAL_BATTERY_SOC_PERCENT=60.0
BATTERY_MINIMUM_SOC_PERCENT=20.0
BATTERY_MAX_CHARGE_POWER_KW=5.0
BATTERY_MAX_DISCHARGE_POWER_KW=5.0
BATTERY_CHARGE_EFFICIENCY=0.95
BATTERY_DISCHARGE_EFFICIENCY=0.95
BATTERY_CAN_CHARGE_FROM_GRID=false

# --- Grid ---
GRID_AVAILABLE=true
ZERO_EXPORT_MODE=false
ZERO_EXPORT_LIMIT_KW=0.0
# Optional outage window in local HH:MM-HH:MM (empty = no scheduled outage)
GRID_OUTAGE_WINDOW=

# --- Simulation ---
SIMULATION_INTERVAL_SECONDS=60
RANDOM_SEED=42
WEATHER_REFRESH_MINUTES=30
WEATHER_MODE=live
SCENARIO=normal_day
OUTPUT_FILE=data/telemetry.jsonl

# --- Backend ingest ---
# Production path: RabbitMQ. Empty RABBITMQ_URL disables AMQP publishing.
# Start local brokers with: docker compose up -d   (from repo root)
# RABBITMQ_URL=amqp://volta:volta@localhost:5672/volta
RABBITMQ_EXCHANGE=telemetry
RABBITMQ_ROUTING_KEY=telemetry.ingest

# Load solar/battery/grid/devices from completed onboarding:
#   python -m simulator.main --from-onboarding --household-id home_... \
#     --ingest-url http://127.0.0.1:8000 --ingest-token dev-ingest-token
# FROM_ONBOARDING=false
# BACKEND_URL=http://127.0.0.1:8000

# Legacy HTTP ingest (tests/dev only). Leave empty when using RabbitMQ.
# INGEST_URL=http://127.0.0.1:8000
# INGEST_TOKEN=dev-ingest-token

# --- Open-Meteo ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_PAST_DAYS=1
