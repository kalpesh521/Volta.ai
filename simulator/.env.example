# Copy to .env and adjust. Every value is optional — defaults are used when omitted.
# Adding a new key here does not require code changes unless a generator reads it.

# --- Household / location ---
HOUSEHOLD_ID=home_001
LOCATION_NAME=Pimpri-Chinchwad
LOCATION_COUNTRY_CODE=IN
# Leave TIMEZONE / LATITUDE / LONGITUDE as fallbacks. Open-Meteo geocoding
# overwrites them at startup when GEOCODE_ON_START=true.
TIMEZONE=Asia/Kolkata
LATITUDE=18.6298
LONGITUDE=73.7997
LOCATION_ELEVATION_M=570
GEOCODE_ON_START=true
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
GEOCODING_LANGUAGE=en
HOUSEHOLD_OCCUPANTS=4
WORK_FROM_HOME=false

# --- Solar (array + inverter) ---
# On-grid | Off-grid | Hybrid (context only; GRID_AVAILABLE / BATTERY_PRESENT drive behaviour)
SYSTEM_TYPE=Hybrid
SOLAR_CAPACITY_KWP=5.0
INVERTER_CAPACITY_KW=5.0
# DC-side derate only (wiring, mismatch, LID). Temperature, soiling, reflection
# and inverter losses are modelled separately — do not fold them in here.
SOLAR_EFFICIENCY=0.92
SHADING_FACTOR=0.97
# Pmax temperature coefficient per °C (mono PERC ≈ 0.0035, poly ≈ 0.004, TOPCon ≈ 0.003)
PV_TEMP_COEFFICIENT_PER_C=0.0037
# Unset = auto: tilt ≈ |latitude| (5–35°), facing the equator (180 = south)
# PANEL_TILT_DEG=18
# PANEL_AZIMUTH_DEG=180
GROUND_ALBEDO=0.2
PANEL_AGE_YEARS=1
PANEL_DEGRADATION_PER_YEAR=0.005
CLEAR_SKY_TURBIDITY=0.92
# Passing-cloud shadows (fast PV ramps) on partly cloudy days
CLOUD_TRANSIENTS=true
SOILING_RATE_PER_DAY=0.0025
SOILING_MAX_LOSS=0.30
INITIAL_SOILING_LOSS_PERCENT=2
# 0 = never cleaned (rain still washes panels)
PANEL_CLEANING_INTERVAL_DAYS=15

# --- Battery ---
BATTERY_PRESENT=true
BATTERY_CAPACITY_KWH=10.0
BATTERY_USABLE_CAPACITY_KWH=8.0
INITIAL_BATTERY_SOC_PERCENT=60.0
BATTERY_MINIMUM_SOC_PERCENT=20.0
BATTERY_MAX_CHARGE_POWER_KW=5.0
BATTERY_MAX_DISCHARGE_POWER_KW=5.0
BATTERY_CHARGE_EFFICIENCY=0.95
BATTERY_DISCHARGE_EFFICIENCY=0.95
BATTERY_CAN_CHARGE_FROM_GRID=false
BATTERY_SOH_PERCENT=98
BATTERY_CYCLE_LIFE=6000
BATTERY_TAPER_START_SOC=90
BATTERY_THERMAL_TIME_CONSTANT_MINUTES=90
BATTERY_MAX_TEMPERATURE_C=55
# Held back for outages when PRIMARY_GOAL=preserve_backup
BATTERY_BACKUP_RESERVE_PERCENT=50
# Off-peak grid charging target when PRIMARY_GOAL=minimize_bill and ToU tariff
GRID_CHARGE_TARGET_SOC_PERCENT=80

# --- Grid ---
# false = off-grid home (grid_status "off_grid")
GRID_AVAILABLE=true
ZERO_EXPORT_MODE=false
ZERO_EXPORT_LIMIT_KW=0.0
GRID_NOMINAL_VOLTAGE_V=230
GRID_NOMINAL_FREQUENCY_HZ=50
# Volt-watt: export is curtailed so the service voltage stays below this
GRID_VOLTAGE_UPPER_LIMIT_V=253
GRID_FEEDER_V_PER_KW=1.2
# Outages: force, fixed window(s), load shedding, and/or seeded random feeder faults
FORCE_GRID_OUTAGE=false
GRID_OUTAGE_WINDOW=
LOAD_SHEDDING_WINDOWS=
RANDOM_GRID_OUTAGES=true
GRID_OUTAGE_RATE_PER_DAY=0.08
GRID_OUTAGE_MEDIAN_MINUTES=25

# --- Goal + tariff (onboarding overrides these) ---
# maximize_self_consumption | minimize_bill | preserve_backup
PRIMARY_GOAL=maximize_self_consumption
# Flat rate | Time-of-use | Slab-based
TARIFF_TYPE=Flat rate
TARIFF_RATE_INR_PER_KWH=8.0
EXPORT_CREDIT_INR_PER_KWH=3.0
METER_TYPE=Net meter
TOU_PEAK_WINDOWS=18:00-22:00
TOU_PEAK_MULTIPLIER=1.2
TOU_OFFPEAK_WINDOWS=22:00-06:00
TOU_OFFPEAK_MULTIPLIER=0.8

# --- Simulation ---
SIMULATION_INTERVAL_SECONDS=60
RANDOM_SEED=42
WEATHER_REFRESH_MINUTES=30
WEATHER_MODE=live
# normal_day, auto (season-aware daily mix), or any scenario in simulator/scenarios.py
SCENARIO=normal_day
OUTPUT_FILE=data/telemetry.jsonl
# JSONL rotation: telemetry.jsonl → .1 … .N when it exceeds OUTPUT_MAX_MB
OUTPUT_MAX_MB=200
OUTPUT_BACKUPS=3
# Keep counters, SOC/SOH, soiling and device sessions across restarts (live clock only)
PERSIST_STATE=true
STATE_DIR=data/state

# --- Backend ingest ---
# Production path: RabbitMQ. Empty RABBITMQ_URL disables AMQP publishing.
# Start local brokers with: docker compose up -d   (from repo root)
# RABBITMQ_URL=amqp://volta:volta@localhost:5672/volta
RABBITMQ_EXCHANGE=telemetry
RABBITMQ_ROUTING_KEY=telemetry.ingest

# Load solar/battery/grid/devices from completed onboarding:
#   python -m simulator.main --from-onboarding --household-id home_... \
#     --ingest-url http://127.0.0.1:8000 --ingest-token dev-ingest-token
# FROM_ONBOARDING=false
# BACKEND_URL=http://127.0.0.1:8000

# Legacy HTTP ingest (tests/dev only). Leave empty when using RabbitMQ.
# INGEST_URL=http://127.0.0.1:8000
# INGEST_TOKEN=dev-ingest-token

# --- Open-Meteo ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_PAST_DAYS=1
